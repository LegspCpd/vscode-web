{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/vs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/usb2.ico"
    },
    {
      "source": "/((?!.*\\.(js|js\\.map|css|css\\.map|json|map|png|svg|ttf|woff|woff2|ico|html|wasm)$)(?!vs/|media/|extensions/|nls\\.).*)",
      "destination": "/index.html"
    }
  ]
}